#!/bin/bash

#SBATCH --job-name=res_ac_sweep
#SBATCH --account=co_rail
#SBATCH --partition=savio4_gpu
#SBATCH --qos=rail_gpu4_high
#SBATCH --gres=gpu:A5000:2
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=60G
#SBATCH --time=48:00:00
#SBATCH --array=0-95
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err

# 2 tasks x 4 chunks x 4 action scales x 3 K x 2 seeds = 192 runs.
# Each array task keeps the two seeds on one node, one A5000 each.
# K critic/actor steps per transition: 4*K critic updates, then K actor updates.
#   chunks: 1, 5, 10, 20
#   action_scale: 0.05, 0.1, 0.2, 0.3
#   K: 1, 2, 4
#   seeds: 101, 10101
#   tasks 0-47 box, 48-95 coffee
#
#   mkdir -p logs
#   sbatch resfit/rl_finetuning/shell/slurm_action_chunk_scale_k_sweep.sh

source ~/.bashrc
conda activate residual_rl
set -uo pipefail

export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export WANDB_DIR=/global/scratch/users/r112358/wandb
export CACHE_DIR=/global/scratch/users/r112358/resfit-cache

cd /global/home/users/r112358/residual-offpolicy-rl
REPO_ROOT="$(pwd)"
export PYTHONPATH="${REPO_ROOT}:${REPO_ROOT}/deps/lerobot:${PYTHONPATH:-}"

mkdir -p logs "${WANDB_DIR}" "${CACHE_DIR}"

CKPT_ROOT=/global/scratch/users/r112358/dexmg-act-ckpts
SEEDS=(101 10101)
CHUNKS=(1 5 10 20)
SCALES=(0.05 0.1 0.2 0.3)
KS=(1 2 4)
NK=${#KS[@]}
NSCALE=${#SCALES[@]}
NC=${#CHUNKS[@]}

g=${SLURM_ARRAY_TASK_ID}
k_i=$((g % NK))
scale_i=$(((g / NK) % NSCALE))
chunk_i=$(((g / (NK * NSCALE)) % NC))
task_i=$((g / (NK * NSCALE * NC)))
K=${KS[${k_i}]}
SCALE=${SCALES[${scale_i}]}
CHUNK=${CHUNKS[${chunk_i}]}
N_UPDATES=$((4 * K))
N_ACTOR=${K}

if [[ "${task_i}" -eq 0 ]]; then
  TASK=TwoArmBoxCleanup
  CONFIG=residual_td3_box_clean_config
  CKPT="${CKPT_ROOT}/TwoArmBoxCleanup/37745620/policy_step_20000"
  WANDB_PROJECT=dexmg-box-clean-residual-td3
elif [[ "${task_i}" -eq 1 ]]; then
  TASK=TwoArmCoffee
  CONFIG=residual_td3_coffee_config
  CKPT="${CKPT_ROOT}/TwoArmCoffee/37745619/policy_step_20000"
  WANDB_PROJECT=dexmg-coffee-residual-td3
else
  echo "Bad task index ${task_i} from array task ${g}"
  exit 1
fi

WANDB_GROUP="${TASK}_c${CHUNK}_a${SCALE}_k${K}"

if [[ ! -f "${CKPT}/policy/config.json" ]]; then
  echo "Missing checkpoint: ${CKPT}"
  exit 1
fi

IFS=',' read -r -a GPU_IDS <<< "${CUDA_VISIBLE_DEVICES:-}"
if [[ ${#GPU_IDS[@]} -lt 2 ]]; then
  echo "Expected 2 GPUs in CUDA_VISIBLE_DEVICES, got '${CUDA_VISIBLE_DEVICES:-}'"
  exit 1
fi

echo "Array task ${g} on $(hostname)"
echo "  task=${TASK} chunk=${CHUNK} action_scale=${SCALE} K=${K}"
echo "  critic_updates=${N_UPDATES} actor_updates=${N_ACTOR} per transition"
echo "  gpus=${GPU_IDS[0]},${GPU_IDS[1]} seeds=${SEEDS[0]},${SEEDS[1]}"
echo "  ckpt=${CKPT}"

pids=()
for i in 0 1; do
  seed=${SEEDS[${i}]}
  gpu=${GPU_IDS[${i}]}
  run_log="logs/${SLURM_JOB_NAME}_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}_seed${seed}.log"
  echo "  seed=${seed} gpu=${gpu} log=${run_log}"
  CUDA_VISIBLE_DEVICES="${gpu}" \
  MUJOCO_EGL_DEVICE_ID="${gpu}" \
  python -m resfit.rl_finetuning.scripts.train_residual_td3 \
    --config-name="${CONFIG}" \
    base_policy.ckpt_path="${CKPT}" \
    algo.action_chunk="${CHUNK}" \
    algo.requery=false \
    algo.offline_fraction=0.0 \
    algo.total_timesteps=200_000 \
    algo.num_updates_per_iteration="${N_UPDATES}" \
    algo.actor_updates_per_iteration="${N_ACTOR}" \
    agent.actor.action_scale="${SCALE}" \
    save_video=false \
    seed="${seed}" \
    wandb.project="${WANDB_PROJECT}" \
    wandb.group="${WANDB_GROUP}" \
    wandb.name="${WANDB_GROUP}_seed${seed}" \
    wandb.mode=online \
    > "${run_log}" 2>&1 &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "${pid}" || status=1
done
exit "${status}"
